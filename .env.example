# Copy to .env and adjust. Nothing here is secret; real credentials never go in Git.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db   # default: the local SQLite registry next to the code
TAXI_MODEL_ALIAS=production                # the API serves models:/taxi-demand@<alias>
TAXI_PSI_WINDOW=300                        # live PSI is computed over the last N requests
